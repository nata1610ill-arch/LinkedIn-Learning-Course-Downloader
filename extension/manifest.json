{
  "manifest_version": 3,
  "name": "LinkedInRec",
  "version": "1.0.3",
  "description": "Detects LinkedIn Learning pages and sends course/video slugs + auth cookies to the local LinkedInRec app.",
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "http://localhost:5177/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkedInRec",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/learning/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
